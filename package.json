    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.13",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "wrangler": "^4.45.0"
